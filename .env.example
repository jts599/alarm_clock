# Docker Hub Configuration
DOCKER_USERNAME=jts599

# Image Tag (usually 'latest' for prod, 'dev' for development)
IMAGE_TAG=latest

# Weather Service Configuration
# Get your coordinates from: https://www.latlong.net/
WEATHER_LONGITUDE=-74.0060
WEATHER_LATITUDE=40.7128

# Runtime Configuration
# Set to true to use mock LIFX service (for testing without hardware)
STUB_LIFX=false

# Set to true to speed up time-based operations (for testing)
FAST_TIMESCALE=false

# LLM Configuration
LLM_MODEL_PATH=/app/models/tinyllama-1.1b-chat.onnx
LLM_ENABLE=true

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

# Node.js Environment
NODE_ENV=production
