# Example .env for docker-compose. Edit values here to configure local/development runs.

# Docker image settings
# DOCKER_USERNAME: Docker Hub username used when pulling/pushing images. Default in compose files
#   falls back to 'jts599' if not set.
DOCKER_USERNAME=jts599

# IMAGE_TAG: tag to use for images (e.g. 'latest', 'dev', or a release/tag name)
IMAGE_TAG=latest

# Timezone used by containers. Accepts values like 'UTC', 'America/Chicago', 'Europe/London'
# If not set, docker-compose files will default to 'UTC'.
TZ=America/Chicago

# Development overrides (only used by docker-compose.dev.yml)
# WEATHER_LONGITUDE and WEATHER_LATITUDE override the weather coordinates used by the backend
# (format: decimal degrees). If you use appsettings.json or another config source you may
# not need these.
WEATHER_LONGITUDE=-74.0060
WEATHER_LATITUDE=40.7128

# Runtime / test toggles (used by docker-compose.dev.yml)
# STUB_LIFX=true  -> use a mock LIFX service (no hardware required)
# FAST_TIMESCALE=true -> speed up time for testing (shortens schedules)
STUB_LIFX=true
FAST_TIMESCALE=true

# Notes:
# - Docker Compose automatically reads this .env file when you run it from the repository root.
# - You can override values at runtime by exporting variables in the shell, e.g.:
#     TZ=UTC docker compose up -d
# - Keep secrets (passwords, tokens) out of this file. Use environment-specific secrets
#   (Docker secrets, or CI secrets) for sensitive values.
