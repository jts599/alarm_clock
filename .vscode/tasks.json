{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/backend.csproj"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "docker-build-debug",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "docker-compose.debug.yml",
        "build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "docker-up-debug",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "docker-compose.debug.yml",
        "up",
        "-d"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "dependsOn": "docker-build-debug"
    }
  ]
}